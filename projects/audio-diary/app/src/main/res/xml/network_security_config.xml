<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only system-trusted CAs: user-installed certificates (a common MITM trick) are ignored. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
