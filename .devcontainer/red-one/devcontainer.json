{
  "name": "Red One",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/projects/red-one",
  "postCreateCommand": "pip install --user -e '.[dev]'",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Red One",
      "onAutoForward": "notify"
    }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Optional. Claude API key for live replies. Leave unset to run in stub mode (free).",
      "documentationUrl": "https://platform.claude.com/"
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python"]
    }
  }
}
